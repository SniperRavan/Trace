{
  "name": "trace",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Ambient AI usage tracker — calm, local, browser-native.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && vite build --config vite.content.config.ts && vite build --config vite.interceptor.config.ts",
    "build:firefox": "vite build --mode firefox",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "framer-motion": "^11.3.0",
    "gpt-tokenizer": "^2.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/chrome": "^0.0.307",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-web-extension": "^4.1.1",
    "vitest": "^3.0.5",
    "webextension-polyfill": "^0.12.0"
  }
}
